APP_NAME=MoviePlatform
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DISPLAY_TIMEZONE=Asia/Beirut

IDENTITY_URL=http://127.0.0.1:8001
CATALOG_URL=http://127.0.0.1:8002
ENGAGEMENT_URL=http://127.0.0.1:8003
SOCIAL_URL=http://127.0.0.1:8004
INTELLIGENCE_URL=http://127.0.0.1:8005
NOTIFICATION_URL=http://127.0.0.1:8006

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

SECRETS_DIR=../secrets

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
