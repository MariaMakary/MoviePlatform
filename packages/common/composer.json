{
    "name": "movieplatform/common",
    "description": "Code shared by the MoviePlatform Gateway and services (secret() helper, and later middleware, events, health check).",
    "type": "library",
    "version": "1.0.0",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "MoviePlatform\\Common\\": "src/"
        },
        "files": [
            "src/secret.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MoviePlatform\\Common\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
