{
    "name": "movieplatform/common",
    "description": "Code shared by the MoviePlatform Gateway and services (secret() helper, and later middleware, events, health check).",
    "type": "library",
    "version": "1.0.0",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^12.0",
        "vlucas/phpdotenv": "^5.4",
        "firebase/php-jwt": "^7.2",
        "illuminate/auth": "^10.0|^12.0",
        "illuminate/http": "^10.0|^12.0",
        "illuminate/routing": "^10.0|^12.0",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.50",
        "orchestra/testbench": "^10.12"
    },
    "autoload": {
        "psr-4": {
            "MoviePlatform\\Common\\": "src/"
        },
        "files": [
            "src/secret.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MoviePlatform\\Common\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MoviePlatform\\Common\\CommonServiceProvider"
            ]
        }
    }
}
