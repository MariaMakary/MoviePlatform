APP_NAME="MoviePlatform Identity"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=UTC
SERVICE_NAME=identity

SECRETS_DIR=../../secrets
JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=identity_db
DB_USERNAME=identity_user

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# Mailtrap sandbox (Email Testing > Inboxes > SMTP); the password goes in secrets/mail_password.
# MAIL_MAILER=log writes the emails to storage/logs instead of sending them.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_FROM_ADDRESS=no-reply@movieplatform.test
MAIL_FROM_NAME=MoviePlatform

GATEWAY_URL=http://localhost:8000
