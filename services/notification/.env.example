APP_NAME="MoviePlatform Notification"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8006
APP_TIMEZONE=UTC
SERVICE_NAME=notification

SECRETS_DIR=../../secrets
JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5438
DB_DATABASE=notification_db
DB_USERNAME=notification_user

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
