APP_NAME="MoviePlatform Notification"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8006
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Beirut
SERVICE_NAME=notification

SECRETS_DIR=../../secrets
JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5438
DB_DATABASE=notification_db
DB_USERNAME=notification_user

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# Reverb (runs from the Gateway). Same id and key as the Gateway; secret in secrets/reverb_app_secret.
BROADCAST_DRIVER=pusher
REVERB_APP_ID=879048
REVERB_APP_KEY=kv9wm5n18i6l6knrgoeh
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
