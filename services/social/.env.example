APP_NAME="MoviePlatform Social"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8004
APP_TIMEZONE=UTC

SECRETS_DIR=../../secrets
JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5436
DB_DATABASE=social_db
DB_USERNAME=social_user

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
