APP_NAME="MoviePlatform Catalog"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002
APP_TIMEZONE=UTC
SERVICE_NAME=catalog

SECRETS_DIR=../../secrets
JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem

LOG_CHANNEL=stack

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=catalog_db
DB_USERNAME=catalog_user

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
