        <mxCell id="e0" edge="1" parent="1" source="r_movies_id" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#000000;fontFamily=Arial;" target="r_movie_genre_movie_id" value="1 : N"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="r_genres_id" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#000000;fontFamily=Arial;" target="r_movie_genre_genre_id" value="1 : N"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="r_movies_id" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#000000;fontFamily=Arial;" target="r_movie_person_movie_id" value="1 : N"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="r_people_id" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#000000;fontFamily=Arial;" target="r_movie_person_person_id" value="1 : N"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="notes" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=12;" value="&lt;b&gt;Constraints &amp;amp; indexes&lt;/b&gt;&lt;br&gt;• movies.tmdb_id, people.tmdb_id, genres.tmdb_id: UNIQUE, NULL for local (admin-created) rows&lt;br&gt;• movie_person.role: CHECK (role IN ('cast','director'))&lt;br&gt;• All FKs: ON DELETE CASCADE (deleting a movie removes its genre links and credits)&lt;br&gt;• Indexes: movies(title) full-text, movies(release_date), movies(popularity), movies(vote_average),&lt;br&gt;&amp;nbsp;&amp;nbsp;movie_person(movie_id, role, cast_order), movie_person(person_id), movie_genre(genre_id)&lt;br&gt;• movies.is_edited = true → TMDB sync does not overwrite admin edits&lt;br&gt;• movie_person: UNIQUE (movie_id, person_id, role), so the TMDB sync can upsert credits without duplicates&lt;br&gt;• movies.popularity: DEFAULT 0 (movies created by an admin have no TMDB popularity)" vertex="1"><mxGeometry height="170" width="1320" x="40" y="580" as="geometry" /></mxCell>
        <mxCell id="ext" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=12;dashed=1;" value="&lt;b&gt;Referenced by other services (by ID, no foreign key)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;movies.id&lt;/b&gt; ← Engagement (ratings, reviews, watchlist, watch_history, list_movie),&lt;br&gt;&amp;nbsp;&amp;nbsp;Social (candidates, movie_nights.winner_movie_id, rooms), Intelligence (recommendations)&lt;br&gt;• &lt;b&gt;genres.id&lt;/b&gt; ← Identity (user_genres)&lt;br&gt;• &lt;b&gt;people.id&lt;/b&gt; ← Intelligence (user_taste_profiles.people_weights keys)&lt;br&gt;Events published: movie.updated, movie.deleted" vertex="1"><mxGeometry height="130" width="840" x="1480" y="580" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
